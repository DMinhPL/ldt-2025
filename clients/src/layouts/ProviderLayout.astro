---
import { GENERAL_RESPONSE_DUMMY } from '../assets/dummy';
import Footer from '../components/commons/footer/Footer.astro';
import Head from '../components/commons/Head.astro';
import Header from '../components/commons/header/Header.astro';
import { defaultLang } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
import { getThemeBackgroundFromPath } from '../utils/theme';

interface Props {
  seo?: SEOResponseType;
}
const { seo } = Astro.props;

const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const bg = getThemeBackgroundFromPath(pathname, defaultLang);
---

<>
  <head>
    <Head seo={seo} />
  </head>
  <body class={`main bg-${bg}`}>
    <Header theme={bg} lang={lang} pathname={pathname} />
    <slot />
    <Footer lang={lang} />
  </body>
</>
