---
import { getContactPage, getGeneral } from '../../api';
import { useTranslations } from '../../i18n/utils';
import ProviderLayout from '../../layouts/ProviderLayout.astro';
import ContactContentWrapper from '../commons/ContactContentWrapper';
import ContactForm from '../commons/ContactForm';
import FooterContactInfo from '../commons/footer/FooterContactInfo.astro';
import MetaKeywords from '../commons/MetaKeywords.astro';
import SocialBlock from '../molecules/SocialBlock.astro';

type Props = {
  lang: SystemLanguageEnum;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
const { data: contactPageData } = await getContactPage(lang);
const { data: generalData } = await getGeneral(lang);
---

<ProviderLayout seo={contactPageData?.seo}>
  <MetaKeywords keywords={contactPageData?.seo?.keywords} />
  <div class='container mx-auto'>
    <ContactContentWrapper client:load>
      <div class='form w-full lg:w-1/2 xl:w-7/12 mt-12 lg:mt-0'>
        <ContactForm client:load lang={lang} general={generalData} />
      </div>
      <div class='form w-full lg:w-1/2 xl:w-5/12 lg:pl-10 xl:pl-14'>
        <h2 class='text-lg font-semibold text-usafa-blue uppercase'>
          {contactPageData?.tag}
        </h2>
        <h3 class='text-[30px] lg:text-3xl xl:text-4xl font-bold lg:mt-5'>
          {contactPageData?.title}
        </h3>
        <p class='mt-3 lg:mt-4'>
          {contactPageData?.description}
        </p>
        <div class='pt-4.5 pb-10 lg:py-10 border-b border-green-ryb'>
          <FooterContactInfo title={t('general.office')} />
        </div>
        <div class='mt-7 lg:mt-6'>
          <h4 class='font-bold text-xl'>{t('general.followUsMedia')}</h4>
          <div class='flex gap-7 items-center mt-4'>
            <SocialBlock />
          </div>
        </div>
      </div>
    </ContactContentWrapper>
  </div>
</ProviderLayout>
