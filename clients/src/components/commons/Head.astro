---
import { Font } from 'astro:assets';

const { title = 'Long Duong Thuan Ltd.', ...props } = Astro.props;
---

<!-- <link rel="sitemap" href="/sitemap-index.xml"> -->
<title>{title}</title>
<meta name='description' content='Welcome to my new Astro site!' />
<meta charset='UTF-8' />
<meta name='viewport' content='width=device-width' />
<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
<link rel='icon' href='/favicon.ico' />
<meta name='generator' content={Astro.generator} />
<!-- Open Graph tags -->
<meta property='og:title' content='Long Duong Thuan Ltd.' />
<meta property='og:type' content='website' />
<meta property='og:url' content='https://www.longduongthuan.com/en/' />
<meta property='og:description' content='Welcome to my new Astro site!' />
<meta
  property='og:image'
  content='https://www.example.com/_astro/seo-banner.BZD7kegZ.webp'
/>
<meta property='og:image:alt' content='' />
<Font cssVariable='--font-inter' preload />
