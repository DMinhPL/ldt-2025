---
import { getGeneral } from '../../../api';
import { getLangFromUrl } from '../../../i18n/utils';
import { SVGIcons } from '../../../utils/icons';

type Props = {
  title: string;
};

const { title } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const { data: generalData } = await getGeneral(lang);

const contactInfo = [
  {
    href: '',
    icon: SVGIcons.location.src,
    text: generalData?.address,
  },
  {
    href: `mailto:${generalData?.email}`,
    icon: SVGIcons.envelop.src,
    text: generalData?.email,
  },
  {
    href: `tel:${generalData?.phone}`,
    icon: SVGIcons.phone.src,
    text: generalData?.phone,
  },
];
---

<div class='text-raisin-black'>
  <h3 class='text-lg lg:text-[22px] font-bold'>{title}</h3>
  <ul class='lg:text-lg lg:mt-5 text-base mt-2 gap-2 flex flex-col'>
    {
      contactInfo.map(({ href, icon, text }) => (
        <li class='flex'>
          <div class='w-6] mt-1.5'>
            <img src={icon} alt='icon' width={17} height={17} />
          </div>
          {href ? (
            <a href={href} class='ml-2 w-full'>
              {text}
            </a>
          ) : (
            <p class='ml-2 w-full -tracking-[0.02em]'>{text}</p>
          )}
        </li>
      ))
    }
  </ul>
</div>
