---
/* eslint-disable @typescript-eslint/no-explicit-any */

import classNames from 'classnames';

type Variants = 'primary' | 'secondary';
type Size = 'base' | 'sm';

export interface Props {
  className?: string;
  variants?: Variants;
  size?: Size;
  loading?: boolean;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  link?: string;

  // allow passing attributes (button or anchor) without being too strict
  [key: string]: any;
}

const {
  className,
  variants = 'primary',
  size = 'base',
  loading = false,
  disabled = false,
  type = 'button',
  link,
  ...rest
} = Astro.props;

const isDisabled = disabled || loading;

const baseClasses = className?.includes('w-')
  ? 'a-button button-base-style rounded-sm px-2'
  : 'a-button px-2 button-base-style w-full';

const buttonClass = classNames(baseClasses, {
  'bg-deep-lemon opacity-30 text-white pointer-events-none border-0':
    isDisabled,
  'bg-green-ryb text-white hover:bg-sap-green':
    !isDisabled && variants === 'primary',
  'h-[45px]': size === 'base',
  'h-[30px]': size === 'sm',
});
---

{
  link ? (
    <a
      href={link}
      class={`${buttonClass} ${className ?? ''} block text-center font-semibold`}
      aria-disabled={isDisabled ? 'true' : 'false'}
      {...rest}
    >
      {loading ? (
        <span class='flex items-center justify-center'>
          <span class='animate-spin rounded-full w-4 h-4 border-4 border-white border-t-transparent' />
        </span>
      ) : (
        <slot />
      )}
    </a>
  ) : (
    <button
      type={type}
      disabled={isDisabled}
      class={`${buttonClass} ${className ?? ''} block text-center font-semibold`}
      {...rest}
    >
      {loading ? (
        <span class='flex items-center justify-center'>
          <span class='animate-spin rounded-full w-4 h-4 border-4 border-white border-t-transparent' />
        </span>
      ) : (
        <slot />
      )}
    </button>
  )
}
