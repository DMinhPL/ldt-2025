---
import Head from '../components/commons/Head.astro';
import '../styles/global.css';
import { getThemeBackgroundFromPath } from '../utils/theme';
import { defaultLang } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
import Header from '../components/commons/header/Header.astro';

const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const bg = getThemeBackgroundFromPath(pathname, defaultLang);
---

<!doctype html>
<html lang='en' data-bg={bg}>
  <head>
    <Head />
  </head>
  <body class={`main bg-${bg}`}>
    <Header theme={bg} lang={lang} pathname={pathname} />
    <slot />
  </body>
</html>

<style is:global>
  html {
    font-family:
      var(--font-inter),
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      Arial,
      sans-serif;
  }
  :root[data-bg='primary'] {
    background-color: #51aa350d;
  }
  :root[data-bg='secondary'] {
    background-color: white;
  }
</style>
