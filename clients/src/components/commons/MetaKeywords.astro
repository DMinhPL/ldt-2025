---
interface Props {
  keywords?: string;
}

const { keywords } = Astro.props;

const keywordList = keywords ? keywords.split(', ').filter(Boolean) : [];
---

{
  keywordList.length > 0 && (
    <div
      class='keywords-meta opacity-0 pointer-events-none absolute top-0 left-0'
      style='visibility: hidden;'
    >
      {keywordList.map((keyword) => (
        <h3 class='seo-keywords'>{keyword}</h3>
      ))}
    </div>
  )
}
